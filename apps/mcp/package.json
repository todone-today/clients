{
  "name": "todone-mcp",
  "version": "0.1.0",
  "description": "Connect Claude, Cursor or any MCP app to your todone lists, goals, calendar and rewards. Runs on your computer, so your lists stay end-to-end encrypted.",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "todone-mcp": "dist/todone-mcp.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/todone-mcp.js --banner:js=\"#!/usr/bin/env node\"",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/todone-today/clients.git",
    "directory": "apps/mcp"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@todone/sdk": "github:todone-today/sdk#v0.10.10",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
