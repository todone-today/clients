# app.todone.today: the app's static files (the TARGET=app build) and, at the same address, todone's API.
# One address for both keeps the session cookie first-party (Safari caps cookies a site's API sets from another
# server to 7 days) and needs no CORS. Fly terminates HTTPS in front of this, so Caddy speaks plain HTTP on :8080.
{
	admin off
	auto_https off
	servers {
		# Fly's proxy is the only thing that reaches this; it says who the visitor is in Fly-Client-IP.
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	# The API, over Fly's private network, in the same region (todone-api, server repo). Rate limits key on the
	# visitor's address: whatever X-Forwarded-For they sent is replaced with the one Fly saw.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:todone-api.internal:4000} {
			header_up X-Forwarded-For {http.request.header.Fly-Client-IP}
			header_up X-Real-IP {http.request.header.Fly-Client-IP}
			header_up -X-Todone-Proxy
			flush_interval -1
		}
	}

	# PostHog (cookieless usage counts, lib/usage.ts) through this address, so tracker blockers don't hide whole
	# visits. Another company: the session cookie never goes there.
	handle /ingest/static/* {
		uri strip_prefix /ingest
		reverse_proxy https://us-assets.i.posthog.com {
			header_up Host us-assets.i.posthog.com
			header_up -Cookie
			header_up -Authorization
		}
	}
	handle /ingest/* {
		uri strip_prefix /ingest
		reverse_proxy https://us.i.posthog.com {
			header_up Host us.i.posthog.com
			header_up -Cookie
			header_up -Authorization
		}
	}

	# The app isn't for search engines (the website is): nothing here gets indexed.
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
"
	}

	handle {
		root * {$SITE_ROOT:/srv}
		# Build files carry their content's hash in the name: kept forever. Pages and the service worker: always
		# checked, so a new version shows on the next open.
		@hashed path /_next/static/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh not path /_next/static/*
		header @fresh Cache-Control "no-cache"
		header /manifest.webmanifest Content-Type application/manifest+json
		try_files {path} {path}.html {path}/index.html
		file_server
	}
	# A page that isn't there: the app's own not-found page.
	handle_errors 404 {
		root * {$SITE_ROOT:/srv}
		rewrite * /404.html
		file_server
	}

	# Browser hardening: no framing (clickjacking), no MIME sniffing, HTTPS only, a tight referrer, no camera or
	# location, and the microphone for Ask todone's voice on this address only.
	header {
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()"
		-Server
	}
}
